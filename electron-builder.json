{
  "appId": "com.jaybhee84.pbbpreaudit",
  "productName": "PBB PreAudit",
  "directories": {
    "output": "release"
  },
  "publish": null,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "desktop/assets/app.ico",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false,
    "installerIcon": "desktop/assets/app.ico",
    "uninstallerIcon": "desktop/assets/app.ico",
    "artifactName": "PBB-PreAudit-Setup-${version}.exe"
  }
}
